{
  "name": "prepa-ecg-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:security": "node --test tests/security.test.mjs",
    "test:journeys": "npm run prisma:generate && node --test tests/journeys.test.mjs",
    "db:auth:prod": "npm run prisma:prepare:prod && node scripts/run-production-prisma.mjs db execute --file prisma/production-auth.sql",
    "teacher:invite": "node scripts/invite-teacher.mjs",
    "teacher:invite:prod": "npm run prisma:generate:prod && node scripts/invite-teacher.mjs --prod",
    "dev": "next dev",
    "build": "node scripts/prepare-build.mjs && next build",
    "start": "next start",
    "ai:check": "node scripts/check-openai.mjs",
    "deploy:check": "node scripts/check-deployment.mjs",
    "env:prepare:prod": "node scripts/prepare-production-env.mjs",
    "lint": "next lint",
    "db:init": "sqlite3 prisma/dev.db < prisma/init.sql",
    "db:init:demo": "sqlite3 prisma/dev.db < prisma/init.sql",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "prisma:prepare:prod": "node scripts/prepare-production-prisma.mjs",
    "prisma:generate:prod": "npm run prisma:prepare:prod && node scripts/run-production-prisma.mjs generate",
    "db:push:prod": "npm run prisma:prepare:prod && node scripts/run-production-prisma.mjs db push",
    "db:indexes:prod": "node scripts/apply-production-indexes.mjs",
    "db:admin:prod": "node scripts/apply-production-admin.mjs",
    "db:legal:prod": "node scripts/apply-production-legal.mjs",
    "admin:create:prod": "node scripts/create-admin.mjs --confirm-admin",
    "pilot:audit:prod": "node scripts/audit-production-pilot.mjs",
    "pilot:load:prod": "node scripts/check-pilot-load.mjs",
    "pilot:smoke:prod": "node scripts/smoke-production-pilot.mjs --confirm-production",
    "storage:cleanup:prod": "node scripts/cleanup-orphaned-storage.mjs",
    "storage:init:prod": "node scripts/init-supabase-storage.mjs",
    "establishment:create": "node scripts/create-establishment.mjs",
    "establishment:create:prod": "node scripts/create-establishment.mjs --prod",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev"
  },
  "dependencies": {
    "@prisma/client": "^6.0.0",
    "@supabase/supabase-js": "^2.104.0",
    "fflate": "^0.8.3",
    "fzstd": "^0.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.5.26",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2"
  },
  "overrides": {
    "next": {
      "postcss": "^8.5.28"
    },
    "@prisma/config": {
      "deepmerge-ts": "^8.0.0"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/sql.js": "^1.4.11",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.0.0",
    "pg": "^8.23.0",
    "postcss": "^8.4.49",
    "prisma": "^6.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2"
  }
}
